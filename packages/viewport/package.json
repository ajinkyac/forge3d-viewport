{
  "name": "@forge3d/viewport",
  "version": "0.0.1",
  "description": "A React Three Fiber viewport library for 3D applications",
  "license": "MIT",
  "author": "Ajinkya Chhatre",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajinkyachhatre/forge3d-viewport"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.0.0",
    "@react-three/fiber": "^8.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": "^0.160.0",
    "three-stdlib": "^2.0.0"
  },
  "devDependencies": {
    "@react-three/drei": "^9.109.0",
    "@react-three/fiber": "^8.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.0",
    "three-stdlib": "^2.29.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  }
}
